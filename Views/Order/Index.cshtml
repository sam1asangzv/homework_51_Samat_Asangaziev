@model IEnumerable<WebApplication1.Models.Order>

@{
    ViewData["Title"] = "Заказы";
}

<h1>Заказы</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Имя покупателя
            </th>
            <th>
                Адрес доставки
            </th>
            <th>
                Номер телефона
            </th>
            <th>
                Смартфон
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ContactPhone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone.Name)
            </td>
        </tr>
}
    </tbody>
</table>
