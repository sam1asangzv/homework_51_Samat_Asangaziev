@model List<WebApplication1.Models.Phone>

@{
    ViewData["Title"] = "Телефоны";
}

<h1>Телефоны</h1>
<div>
    <a asp-action="Create">Добавить телефон</a>
</div>
@if (Model.Count == 0)
{
    <p>Телефоны пока не добавлены</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Название</th>
            <th>Производитель</th>
            <th>Цена в долларах</th>
            <th>Фото</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Company</td>
                <td>@item.Price</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name" class="phone-list-image" />
                    }
                </td>
                <td>
                    <a asp-action="Create" asp-controller="Order" asp-route-id="@item.Id">Заказать</a> |
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактировать</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Подробнее</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
